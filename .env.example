# Flask Secret Key
FLASK_SECRET_KEY=replace-with-a-random-secret

# --- Local Development (MySQL running on your laptop) ---
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_local_password
# MYSQL_DATABASE=spend_smart_db

# --- Aiven Cloud MySQL (For Render Environment Variables) ---
MYSQL_HOST=mysql-xxxx.aivencloud.com
MYSQL_PORT=12345
MYSQL_USER=avnadmin
MYSQL_PASSWORD=your_aiven_password
MYSQL_DATABASE=defaultdb
MYSQL_SSL=true
